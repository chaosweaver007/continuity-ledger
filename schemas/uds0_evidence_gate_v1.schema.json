  "allOf": [
    {
      "if": {
        "properties": {
          "L2_correspondence": {
            "properties": {
              "mode": {
                "const": "L2c"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "L1_observation": {
            "properties": {
              "event_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "event_at_utc"
            ]
          },
          "L2_correspondence": {
            "required": [
              "target_predicate",
              "preregistration"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "L3_causation": {
            "properties": {
              "adjudication": {
                "const": "SUPPORTED"
              }
            },
            "required": [
              "adjudication"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "L2_correspondence": {
            "properties": {
              "mode": {
                "const": "L2c"
              }
            }
          },
          "L3_causation": {
            "required": [
              "empirical_testbench",
              "transition_receipt"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "receipt_router": {
            "properties": {
              "route": {
                "const": "L2E_EXPLORATORY"
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "receipt_router": {
            "properties": {
              "receipt_type": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "receipt_router": {
            "properties": {
              "route": {
                "const": "EMPIRICAL"
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "receipt_router": {
            "properties": {
              "receipt_type": {
                "const": "R_empirical"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "receipt_router": {
            "properties": {
              "route": {
                "const": "CONFORMANCE"
              }
            },
            "required": [
              "route"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "receipt_router": {
            "properties": {
              "receipt_type": {
                "const": "R_conformance"
              }
            }
          }
        }
      }
    }
  ]
