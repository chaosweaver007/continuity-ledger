{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/chaosweaver007/continuity-ledger/main/schemas/uds0_evidence_gate_v1.schema.json",
  "title": "UDS-0 Evidence Gate Record v1.0",
  "description": "Structural schema for typed evidence records separating observation, deterministic derivation, correspondence, and causal attribution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "error_registry_version",
    "L1_observation",
    "D1_derivations",
    "L2_correspondence",
    "L3_causation"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "error_registry_version": {
      "type": "string",
      "const": "1.0"
    },
    "symbol_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol_id", "namespace", "layer", "definition"],
        "properties": {
          "symbol_id": { "type": "string", "minLength": 1 },
          "namespace": {
            "type": "string",
            "enum": [
              "ZERO_HERMENEUTIC",
              "ZERO_OPERATIONAL",
              "ZERO_CAUSAL_HYPOTHESIS",
              "GENERAL_HERMENEUTIC",
              "GENERAL_OPERATIONAL",
              "GENERAL_CAUSAL_HYPOTHESIS"
            ]
          },
          "layer": {
            "type": "string",
            "enum": ["L2", "L2c", "L3"]
          },
          "definition": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "namespace": { "const": "ZERO_HERMENEUTIC" } },
              "required": ["namespace"]
            },
            "then": {
              "properties": { "layer": { "const": "L2" } }
            }
          },
          {
            "if": {
              "properties": { "namespace": { "const": "ZERO_OPERATIONAL" } },
              "required": ["namespace"]
            },
            "then": {
              "properties": { "layer": { "const": "L2c" } }
            }
          },
          {
            "if": {
              "properties": { "namespace": { "const": "ZERO_CAUSAL_HYPOTHESIS" } },
              "required": ["namespace"]
            },
            "then": {
              "properties": { "layer": { "const": "L3" } }
            }
          }
        ]
      }
    },
    "L1_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_artifact",
        "extracted_observation",
        "observed_at_utc",
        "ingested_at_utc"
      ],
      "properties": {
        "raw_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_sha256",
            "artifact_ref",
            "media_type",
            "byte_length",
            "acquisition_method"
          ],
          "properties": {
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "artifact_ref": {
              "type": "string",
              "format": "uri"
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1
            },
            "acquisition_method": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "extracted_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_sha256",
            "canonicalization_id",
            "extraction_method",
            "extractor_version",
            "raw_payload"
          ],
          "properties": {
            "payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "canonicalization_id": {
              "type": "string",
              "enum": ["UDS-C14N-TEXT-v1", "UDS-C14N-JSON-v1"]
            },
            "extraction_method": {
              "type": "string",
              "enum": [
                "DIRECT_RAW",
                "MECHANICAL_DETERMINISTIC",
                "MANUAL_TRANSCRIPTION",
                "OCR_HEURISTIC",
                "MODEL_ASSISTED_HEURISTIC"
              ]
            },
            "extractor_version": {
              "type": "string",
              "minLength": 1
            },
            "extraction_confidence": {
              "type": ["number", "null"],
              "minimum": 0.0,
              "maximum": 1.0
            },
            "source_region": {
              "type": ["string", "null"]
            },
            "raw_payload": {}
          }
        },
        "event_at_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "ingested_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "event_time_attestation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["attestation_type", "attestation_ref"],
          "properties": {
            "attestation_type": { "type": "string", "minLength": 1 },
            "attestation_ref": { "type": "string", "minLength": 1 },
            "attestation_sha256": {
              "type": ["string", "null"],
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "D1_derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "derivation_id",
          "operation_id",
          "operation_version",
          "input_refs",
          "parameters",
          "output",
          "deterministic"
        ],
        "properties": {
          "derivation_id": { "type": "string", "minLength": 1 },
          "operation_id": { "type": "string", "minLength": 1 },
          "operation_version": { "type": "string", "minLength": 1 },
          "implementation_sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "input_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "parameters": { "type": "object" },
          "output": {},
          "deterministic": { "type": "boolean", "const": true },
          "target_predicate_ref": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "L2_correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "schema_identifier", "mapping_expression"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["L2e", "L2c"]
        },
        "schema_identifier": {
          "type": "string",
          "minLength": 1
        },
        "mapping_expression": {
          "type": "string",
          "minLength": 1
        },
        "exploratory_notes": {
          "type": ["string", "null"]
        },
        "target_predicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "predicate_id",
            "namespace",
            "expression",
            "sample_space_id",
            "target_space_cardinality",
            "null_hypothesis_hit_probability",
            "evidentiary_p_threshold",
            "success_criteria",
            "failure_criteria"
          ],
          "properties": {
            "predicate_id": { "type": "string", "minLength": 1 },
            "namespace": {
              "type": "string",
              "enum": ["GENERAL_OPERATIONAL", "ZERO_OPERATIONAL"]
            },
            "expression": { "type": "string", "minLength": 1 },
            "sample_space_id": { "type": "string", "minLength": 1 },
            "target_space_cardinality": { "type": "integer", "minimum": 1 },
            "null_hypothesis_hit_probability": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "evidentiary_p_threshold": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "maximum": 1.0
            },
            "success_criteria": { "type": "string", "minLength": 1 },
            "failure_criteria": { "type": "string", "minLength": 1 },
            "event_window": { "type": ["string", "null"] }
          }
        },
        "preregistration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registered_at_utc",
            "commitment_payload_sha256",
            "external_commitment"
          ],
          "properties": {
            "registered_at_utc": {
              "type": "string",
              "format": "date-time"
            },
            "commitment_payload_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "external_commitment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["commitment_type", "commitment_hash", "anchor_ref"],
              "properties": {
                "commitment_type": {
                  "type": "string",
                  "enum": [
                    "RFC3161_TIMESTAMP",
                    "TRANSPARENCY_LOG",
                    "MERKLE_ROOT_ANCHOR"
                  ]
                },
                "commitment_hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "anchor_ref": {
                  "type": "string",
                  "format": "uri"
                },
                "inclusion_proof": {
                  "type": ["string", "null"]
                },
                "provider_verification_status": {
                  "type": "string",
                  "enum": ["NOT_DEMONSTRATED", "VERIFIED", "FAILED"]
                }
              }
            }
          }
        }
      }
    },
    "L3_causation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudication",
        "candidate_hypotheses",
        "causal_exclusivity_demonstrated"
      ],
      "properties": {
        "adjudication": {
          "type": "string",
          "enum": ["NOT_DEMONSTRATED", "REFUTED", "SUPPORTED"]
        },
        "causal_exclusivity_demonstrated": { "type": "boolean" },
        "preferred_explanation": { "type": ["string", "null"] },
        "candidate_hypotheses": {
          "type": "object",
          "required": ["H0"],
          "minProperties": 2,
          "propertyNames": { "pattern": "^H[0-9]+$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "status"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "status": {
                "type": "string",
                "enum": [
                  "UNTESTED",
                  "UNDISPROVEN",
                  "DISFAVORED",
                  "DISPROVEN",
                  "SUPPORTED"
                ]
              },
              "evidence_measure": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "p_value",
                      "likelihood_ratio",
                      "bayes_factor",
                      "effect_size",
                      "custom"
                    ]
                  },
                  "value": { "type": ["number", "string"] },
                  "protocol_ref": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "empirical_testbench": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "null_model",
            "test_protocol",
            "adjudication_rule",
            "reproducible_artifact_ref"
          ],
          "properties": {
            "null_model": { "type": "string", "minLength": 1 },
            "test_protocol": { "type": "string", "minLength": 1 },
            "adjudication_rule": { "type": "string", "minLength": 1 },
            "reproducible_artifact_ref": { "type": "string", "minLength": 1 }
          }
        },
        "transition_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_type",
            "to_type",
            "supported_hypotheses",
            "validator_version",
            "validated_at_utc",
            "receipt_canonicalization_id",
            "receipt_digest_sha256",
            "validator_key_id",
            "signature_algorithm",
            "validator_signature"
          ],
          "properties": {
            "from_type": { "type": "string", "const": "L2c" },
            "to_type": { "type": "string", "const": "L3" },
            "supported_hypotheses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^H[0-9]+$" }
            },
            "validator_version": { "type": "string", "minLength": 1 },
            "validated_at_utc": { "type": "string", "format": "date-time" },
            "receipt_canonicalization_id": {
              "type": "string",
              "enum": ["UDS-C14N-JSON-v1"]
            },
            "receipt_digest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "validator_key_id": { "type": "string", "minLength": 1 },
            "signature_algorithm": { "type": "string", "minLength": 1 },
            "validator_signature": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "L2_correspondence": {
            "properties": { "mode": { "const": "L2c" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "L1_observation": {
            "properties": {
              "event_at_utc": { "type": "string", "format": "date-time" }
            },
            "required": ["event_at_utc"]
          },
          "L2_correspondence": {
            "required": ["target_predicate", "preregistration"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "L3_causation": {
            "properties": { "adjudication": { "const": "SUPPORTED" } },
            "required": ["adjudication"]
          }
        }
      },
      "then": {
        "properties": {
          "L2_correspondence": {
            "properties": { "mode": { "const": "L2c" } }
          },
          "L3_causation": {
            "required": ["empirical_testbench", "transition_receipt"]
          }
        }
      }
    }
  ]
}
